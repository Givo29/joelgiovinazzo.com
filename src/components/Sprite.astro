---
// Inlines every icon in src/icons as a <symbol>, so icons ship in the HTML
// rather than as a second request. Reference them with <use href="#name">.
// Icons are drawn on a 120-unit grid (see scripts/icons.mjs); the 140-unit
// viewBox renders them at 24px in the top-left of the 28px icon boxes.
const files = import.meta.glob<string>("../icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const symbols = Object.entries(files)
  .map(([path, svg]) => {
    const id = path.slice(path.lastIndexOf("/") + 1, -4);
    return svg
      .trim()
      .replace(/^<svg[^>]*>/, `<symbol id="${id}" viewBox="0 0 140 140">`)
      .replace(/<\/svg>$/, "</symbol>");
  })
  .join("");
---

<svg style="display:none" set:html={symbols} />
