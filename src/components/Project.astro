---
interface Props {
  name: string;
  githubLink: string;
}

const { name, githubLink } = Astro.props;
---

<li class="project">
  <div>
    <p class="project-name">
      <a href={githubLink} class="link">{name}</a>
    </p>
    <div class="project-desc">
      <p>
        <slot name="desc" />
      </p>
    </div>
  </div>
  <dl class="project-stack">
    <slot />
  </dl>
</li>
